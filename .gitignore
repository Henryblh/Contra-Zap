# Dependências (instaláveis via `npm install`, nunca fazem sentido versionadas)
/node_modules/
/public/app/node_modules/

# Build da interface React — gerado por `npm run build` dentro de public/app
# (ou por GameStart.js). É artefato: sempre reconstruído, nunca versionado.
/public/dist/

# Logs e variáveis de ambiente
npm-debug.log*
*.log
.env
.env.local

# Arquivos de SO
.DS_Store
Thumbs.db

# Banco SQLite local (gerado a partir de banco.json na primeira execução)
/banco.sqlite
/banco.sqlite-*

# Segredo de assinatura do JWT (gerado automaticamente na primeira execução
# se JWT_SECRET não estiver no ambiente) — nunca deve ir pro git
/jwt.secret

# Default ignored files
/shelf/
/.idea/
# Editor-based HTTP Client requests
/httpRequests/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml

# Treino do bot (self-play/PPO, ver training/env_bridge.js) — venv Python e
# artefatos gerados (checkpoints, logs), nada disso deve ir pro repo do grupo.
/training/.venv/
/training/checkpoints/
/training/logs/
/training/runs/
__pycache__/
*.pyc

/conexao/login.test.js
/conexao/SalaManager.test.js
/conexao/socketServer.test.js
/conexao/jwt.test.js
/conexao/cadastro.test.js
/conexao/cleanup.test.js
